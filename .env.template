# This is a template for your environment variables.
# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit the .env file to a public repository.
# -- PostgreSQL Database Settings --
# The password for the PostgreSQL database user.
# MUST be set to a strong, unique password.
POSTGRES_PASSWORD=YourSuperSecretPassword
# -- (Optional) You can customize the database name and user if needed. --
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_HOST=postgres

COPYRIGHT_NAME="Your Name"

# -- n8n Core Settings --
# A 32-character hexadecimal string used for encrypting credentials.
# This value is critical. If you lose it, your credentials are not recoverable.
# MUST be set to a secure, randomly generated key.
# Generate one with PowerShell (Windows):
#   -join ((0..31) | ForEach-Object { '{0:x}' -f (Get-Random -Minimum 0 -Maximum 16) })
# Generate one with Bash (Fedora):
#   openssl rand -hex 16
N8N_E_KEY=YourGenerated32CharacterEncryptionKeyy

# The API key for n8n. The n8n-mcp service uses this to manage workflows.
# MUST be generated from the n8n UI (Settings -> API) after the first launch.
# See README.md for instructions.
N8N_API_KEY=Your_n8n_API_Key_Goes_Here

# -- General Settings --
# A list of valid zones can be found here: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
GENERIC_TIMEZONE=America/Denver

# --- n8n Worker Concurrency ---
# The number of workflows one worker instance can run at the same time.
CONCURRENCY=5

# -- Backup Settings --
# (Optional) The number of days to keep backups. Older backups will be automatically deleted.
BACKUP_RETENTION_DAYS=7


# -- AI / Ollama Settings --
# The default model to be pulled by the ollama-setup service and used by n8n-mcp.
# You can change this to any valid model from the Ollama Hub (e.g., 'llama3:latest', 'mistral:latest').
OLLAMA_DEFAULT_MODEL=deepcoder:latest #deepseek-r1:70b
OLLAMA_WEBUI_PORT=3001
